{
  "$defs": {
    "InvestigationTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "logs",
            "metrics",
            "database",
            "changes"
          ],
          "title": "Role",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "allowed_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "filters": {
          "additionalProperties": true,
          "title": "Filters",
          "type": "object"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "expected_discriminator": {
          "minLength": 1,
          "title": "Expected Discriminator",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "role",
        "question",
        "allowed_tools",
        "reason",
        "expected_discriminator"
      ],
      "title": "InvestigationTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "INVESTIGATE",
        "FINALIZE",
        "ABSTAIN"
      ],
      "title": "Action",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "assignments": {
      "items": {
        "$ref": "#/$defs/InvestigationTask"
      },
      "title": "Assignments",
      "type": "array"
    },
    "selected_hypothesis_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Hypothesis Id"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    }
  },
  "required": [
    "action",
    "reason"
  ],
  "title": "CoordinatorDecision",
  "type": "object"
}
