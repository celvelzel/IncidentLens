{
  "$defs": {
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "hypothesis_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "culprit_service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Culprit Service",
          "type": "string"
        },
        "failure_mode": {
          "minLength": 1,
          "title": "Failure Mode",
          "type": "string"
        },
        "support_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Support Ids",
          "type": "array"
        },
        "against_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Against Ids",
          "type": "array"
        },
        "predicted_observations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Predicted Observations",
          "type": "array"
        },
        "status": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "SUPPORTED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "culprit_service",
        "failure_mode"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "RemediationPlan": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Incident Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "root_cause_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Root Cause Version",
          "type": "string"
        },
        "execution_mode": {
          "const": "PLAN_ONLY",
          "default": "PLAN_ONLY",
          "title": "Execution Mode",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "affected_services": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Services",
          "type": "array"
        },
        "actions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "risks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Risks",
          "type": "array"
        },
        "verification_steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification Steps",
          "type": "array"
        },
        "rollback": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Rollback",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "incident_id",
        "run_id",
        "root_cause_version",
        "objective",
        "affected_services",
        "actions",
        "preconditions",
        "risks",
        "verification_steps",
        "rollback",
        "evidence_ids"
      ],
      "title": "RemediationPlan",
      "type": "object"
    },
    "TerminationResult": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "2",
          "title": "Protocol Version",
          "type": "string"
        },
        "reason": {
          "enum": [
            "PLAN_READY",
            "DIAGNOSIS_READY",
            "INCONCLUSIVE",
            "BUDGET_EXHAUSTED",
            "PLAN_FAILED",
            "UNRECOVERABLE_ERROR",
            "NO_ALERT",
            "STOP_TIMEOUT"
          ],
          "title": "Reason",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "SUCCESS",
            "ABSTAINED",
            "NO_ACTION",
            "FAILED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "failure_stage": {
          "anyOf": [
            {
              "enum": [
                "monitoring",
                "coordinate",
                "dispatch",
                "merge",
                "verify",
                "finalize",
                "diagnosis",
                "remediation",
                "stop",
                "runtime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Stage"
        },
        "stop_completed": {
          "title": "Stop Completed",
          "type": "boolean"
        },
        "runtime_failure": {
          "title": "Runtime Failure",
          "type": "boolean"
        }
      },
      "required": [
        "protocol_version",
        "reason",
        "outcome",
        "failure_stage",
        "stop_completed",
        "runtime_failure"
      ],
      "title": "TerminationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Incident Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "RESOLVED",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "root_cause": {
      "anyOf": [
        {
          "$ref": "#/$defs/Hypothesis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "causal_chain": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Causal Chain",
      "type": "array"
    },
    "supporting_evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "rejected_hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Rejected Hypotheses",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    },
    "stop_reason": {
      "minLength": 1,
      "title": "Stop Reason",
      "type": "string"
    },
    "diagnosis_status": {
      "anyOf": [
        {
          "enum": [
            "RESOLVED",
            "INCONCLUSIVE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagnosis Status"
    },
    "remediation_status": {
      "default": "NOT_STARTED",
      "enum": [
        "NOT_STARTED",
        "PLAN_READY",
        "PLAN_FAILED",
        "SKIPPED"
      ],
      "title": "Remediation Status",
      "type": "string"
    },
    "workflow_status": {
      "default": "FINISHED",
      "enum": [
        "RUNNING",
        "STOPPING",
        "FINISHED",
        "FAILED"
      ],
      "title": "Workflow Status",
      "type": "string"
    },
    "remediation_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemediationPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "termination": {
      "anyOf": [
        {
          "$ref": "#/$defs/TerminationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "incident_id",
    "status",
    "stop_reason"
  ],
  "title": "RCAReport",
  "type": "object"
}
