{
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Finding Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Incident Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "logs",
        "metrics",
        "database",
        "changes"
      ],
      "title": "Role",
      "type": "string"
    },
    "claim": {
      "minLength": 1,
      "title": "Claim",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "relation": {
      "enum": [
        "supports",
        "refutes",
        "neutral"
      ],
      "title": "Relation",
      "type": "string"
    },
    "confidence_qualifier": {
      "enum": [
        "supported",
        "weak",
        "unknown"
      ],
      "title": "Confidence Qualifier",
      "type": "string"
    },
    "followup_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Followup Question"
    }
  },
  "required": [
    "finding_id",
    "task_id",
    "run_id",
    "incident_id",
    "role",
    "claim",
    "evidence_ids",
    "relation",
    "confidence_qualifier"
  ],
  "title": "Finding",
  "type": "object"
}
