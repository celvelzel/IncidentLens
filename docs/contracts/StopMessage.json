{
  "additionalProperties": false,
  "properties": {
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Incident Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "stop_reason": {
      "enum": [
        "PLAN_READY",
        "DIAGNOSIS_READY",
        "INCONCLUSIVE",
        "BUDGET_EXHAUSTED",
        "PLAN_FAILED",
        "UNRECOVERABLE_ERROR",
        "NO_ALERT",
        "STOP_TIMEOUT"
      ],
      "title": "Stop Reason",
      "type": "string"
    },
    "message_type": {
      "default": "WORKFLOW_STOP_REQUESTED",
      "enum": [
        "WORKFLOW_STOP_REQUESTED",
        "STOP_ACK"
      ],
      "title": "Message Type",
      "type": "string"
    },
    "protocol_version": {
      "const": "2",
      "default": "2",
      "title": "Protocol Version",
      "type": "string"
    },
    "role": {
      "default": "coordinator",
      "title": "Role",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "run_id",
    "stop_reason"
  ],
  "title": "StopMessage",
  "type": "object"
}
