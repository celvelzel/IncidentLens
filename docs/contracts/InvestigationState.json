      "type": "object"
    },
    "InvestigationTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "logs",
