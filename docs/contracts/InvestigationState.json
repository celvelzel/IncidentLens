        "task_id",
        "role",
        "question",
        "allowed_tools",
        "reason",
        "expected_discriminator"
      ],
      "title": "InvestigationTask",
      "type": "object"
    },
    "RCAReport": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Incident Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "RESOLVED",
            "INCONCLUSIVE",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        },
        "root_cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hypothesis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "causal_chain": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Causal Chain",
          "type": "array"
        },
        "supporting_evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "rejected_hypotheses": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Rejected Hypotheses",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "stop_reason": {
          "minLength": 1,
          "title": "Stop Reason",
          "type": "string"
        },
        "diagnosis_status": {
          "anyOf": [
            {
              "enum": [
                "RESOLVED",
                "INCONCLUSIVE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnosis Status"
        },
        "remediation_status": {
          "default": "NOT_STARTED",
          "enum": [
            "NOT_STARTED",
            "PLAN_READY",
            "PLAN_FAILED",
            "SKIPPED"
          ],
          "title": "Remediation Status",
          "type": "string"
        },
        "workflow_status": {
          "default": "FINISHED",
          "enum": [
            "RUNNING",
            "STOPPING",
            "FINISHED",
            "FAILED"
          ],
          "title": "Workflow Status",
          "type": "string"
        },
        "remediation_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemediationPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "incident_id",
        "status",
        "stop_reason"
      ],
      "title": "RCAReport",
      "type": "object"
    },
    "RemediationPlan": {
      "additionalProperties": false,
