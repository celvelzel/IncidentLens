{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_rounds": {
          "default": 4,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 12,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_llm_calls": {
          "default": 16,
          "minimum": 0,
          "title": "Max Llm Calls",
          "type": "integer"
        },
        "max_wall_seconds": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Max Wall Seconds",
          "type": "number"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CasePublicInput": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Incident Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "observed_symptoms": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Observed Symptoms",
          "type": "array"
        },
        "services": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "incident_id",
        "title",
        "started_at",
        "observed_symptoms",
        "services"
      ],
      "title": "CasePublicInput",
      "type": "object"
    },
    "CoordinatorDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "INVESTIGATE",
            "FINALIZE",
            "ABSTAIN"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/InvestigationTask"
          },
          "title": "Assignments",
          "type": "array"
        },
        "selected_hypothesis_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Hypothesis Id"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "CoordinatorDecision",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Incident Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "logs",
            "metrics",
            "changes",
            "configs",
            "topology",
            "database"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Service",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "evidence_id",
        "incident_id",
        "source_type",
        "service",
        "observed_at",
        "source_path",
        "excerpt"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Finding Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Incident Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "logs",
            "metrics",
            "database",
            "changes"
          ],
          "title": "Role",
          "type": "string"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "relation": {
          "enum": [
            "supports",
            "refutes",
            "neutral"
          ],
          "title": "Relation",
          "type": "string"
        },
        "confidence_qualifier": {
          "enum": [
            "supported",
            "weak",
            "unknown"
          ],
          "title": "Confidence Qualifier",
          "type": "string"
        },
        "followup_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Followup Question"
        }
      },
      "required": [
        "finding_id",
        "task_id",
        "run_id",
        "incident_id",
        "role",
        "claim",
        "evidence_ids",
        "relation",
        "confidence_qualifier"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "hypothesis_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "culprit_service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Culprit Service",
          "type": "string"
        },
        "failure_mode": {
          "minLength": 1,
          "title": "Failure Mode",
          "type": "string"
        },
        "support_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Support Ids",
          "type": "array"
        },
        "against_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Against Ids",
          "type": "array"
        },
        "predicted_observations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Predicted Observations",
          "type": "array"
        },
        "status": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "SUPPORTED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        }
