        "run_id",
        "root_cause_version",
        "objective",
        "affected_services",
        "actions",
        "preconditions",
        "risks",
        "verification_steps",
        "rollback",
        "evidence_ids"
      ],
      "title": "RemediationPlan",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "target_hypothesis_id": {
          "maxLength": 128,
