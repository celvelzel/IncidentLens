{
  "$defs": {
    "Demonstration": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        }
      },
      "required": [
        "inputs",
        "output"
      ],
      "title": "Demonstration",
      "type": "object"
    },
    "TaskPrompt": {
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "demonstrations": {
          "items": {
            "$ref": "#/$defs/Demonstration"
          },
          "maxItems": 8,
          "title": "Demonstrations",
          "type": "array"
        }
      },
      "required": [
        "instructions"
      ],
      "title": "TaskPrompt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "incidentlens-task-json-v1",
      "default": "incidentlens-task-json-v1",
      "title": "Format",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "base_prompt_version": {
      "title": "Base Prompt Version",
      "type": "string"
    },
    "base_prompt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Base Prompt Sha256",
      "type": "string"
    },
    "optimizer": {
      "enum": [
        "manual",
        "LabeledFewShot",
        "BootstrapFewShot",
        "MIPROv2"
      ],
      "title": "Optimizer",
      "type": "string"
    },
    "status": {
      "default": "candidate",
      "enum": [
        "candidate",
        "reviewed"
      ],
      "title": "Status",
      "type": "string"
    },
    "reviewer": {
      "default": "",
      "title": "Reviewer",
      "type": "string"
    },
    "review_evidence": {
      "default": "",
      "title": "Review Evidence",
      "type": "string"
    },
    "training_data_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Training Data Sha256",
      "type": "string"
    },
    "optimization_provenance": {
      "additionalProperties": true,
      "title": "Optimization Provenance",
      "type": "object"
    },
    "tasks": {
      "additionalProperties": {
        "$ref": "#/$defs/TaskPrompt"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "analysis",
          "verify"
        ]
      },
      "title": "Tasks",
      "type": "object"
    }
  },
  "required": [
    "version",
    "base_prompt_version",
    "base_prompt_sha256",
    "optimizer",
    "training_data_sha256",
    "tasks"
  ],
  "title": "PromptBundle",
  "type": "object"
}
