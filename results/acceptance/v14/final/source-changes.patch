index 0000000..8f24262
--- /dev/null
+++ b/src/incident_lens/incidentbench/scenarios/world.py
@@ -0,0 +1,218 @@
+"""Resource interventions -> dependency propagation -> independently encoded observations.
+
+Private inputs choose timelines, workloads, mechanisms and observation placement. No
+incident/family identifier is used to infer an answer. These are deliberately small
+deterministic queue/capacity models, not production system fidelity claims.
+"""
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+
+@dataclass(frozen=True)
+class World:
+    mechanism: str
+    root_service: str
+    started_at: datetime
+    trigger_at: datetime
+    symptom_at: datetime
+    demand: int
+    capacity: int
+    delay_ms: int
+    missing: bool
+    misleading: bool
+
+
+def simulate(spec: dict, variant: dict) -> World:
+    start = datetime.fromisoformat(spec["started_at"])
+    if start.utcoffset() is None:
+        raise ValueError("scenario time must have timezone")
+    mechanism = variant.get("mechanism", spec["mechanism"])
+    demand = int(variant.get("demand", spec.get("demand", 120)))
+    capacity = int(variant.get("capacity", spec.get("capacity", 100)))
+    if capacity <= 0 or demand <= 0:
+        raise ValueError("positive workload and capacity required")
+    trigger = start + timedelta(seconds=int(spec.get("trigger_seconds", 10)))
+    lag = int(spec.get("propagation_seconds", 5))
+    if lag <= 0:
+        raise ValueError("symptoms must follow intervention")
+    service = {
+        "backend_pool_config_regression": "backend",
+        "backend_resource_saturation": "backend",
+        "postgres_connection_exhaustion": "postgres",
+        "postgres_lock_contention": "postgres",
+        "postgres_slow_query": "postgres",
+        "redis_unavailable": "redis",
+        "payment_external_timeout": "payment",
+        "healthy": "backend",
+    }.get(mechanism, spec.get("root_service", "backend"))
+    if mechanism in {"postgres_connection_exhaustion", "backend_resource_saturation"}:
+        if demand < capacity:
+            raise ValueError("capacity intervention does not produce overload")
+    return World(
+        mechanism,
+        service,
+        start,
+        trigger,
+        trigger + timedelta(seconds=lag),
+        demand,
+        capacity,
+        max(3500, (demand - capacity + 1) * 100),
+        variant["kind"] == "missing",
+        variant["kind"] == "misleading",
+    )
+
+
+def encode(world: World, incident_id: str) -> tuple[list[dict], dict]:
+    """Encode world measurements with provenance; retain candidate roles privately."""
+    rows, roles = [], {"support": [], "contradicting": [], "misleading": []}
+
+    def observe(source, service, at, excerpt, metadata=None, role=None):
+        row = dict(
+            evidence_id=f"{incident_id}-E-{len(rows) + 1:03d}",
+            incident_id=incident_id,
+            source_type=source,
+            service=service,
+            observed_at=at.isoformat(),
+            source_path=f"public/{source}.jsonl",
+            excerpt=excerpt,
+            metadata=metadata or {},
+        )
+        if source == "metrics":
+            row["source_path"] = "public/metrics.csv"
+        rows.append(row)
+        if role:
+            roles[role].append(row["evidence_id"])
+        return row
+
+    def metric(service, at, name, value, unit, role=None):
+        observe(
+            "metrics",
+            service,
+            at,
+            f"{name}={value} {unit}",
+            dict(metric_name=name, value=value, unit=unit),
+            role,
+        )
+
+    # Every case has a healthy prefix. It is context, never asserted as current health.
+    metric("backend", world.started_at, "request_latency_ms", 40, "ms")
+    observe("logs", "gateway", world.started_at, "Request completed with HTTP 200")
+    mode, at = world.mechanism, world.trigger_at
+    if not world.missing and mode != "healthy":
+        if mode == "backend_pool_config_regression":
+            observe(
+                "changes",
+                "backend",
+                at,
+                "Runtime settings deployment applied",
+                {"change_id": "runtime-1", "change_type": "configuration"},
+                "support",
+            )
+            observe(
+                "configs",
+                "backend",
+                at,
+                f"db_pool_max 20 -> 2; concurrency={world.demand}",
+                {"change_id": "runtime-1"},
+                "support",
+            )
+            metric("backend", at, "pool_waiters", max(1, world.demand - 2), "requests")
+            metric("postgres", at, "connections_active", 30, "connections", "contradicting")
+            observe(
+                "database",
+                "postgres",
+                at,
+                "Server connections below limit",
+                dict(category="connections", connection_count=30, connection_limit=100),
+                "contradicting",
+            )
+        elif mode == "postgres_connection_exhaustion":
+            metric(
+                "postgres",
+                at,
+                "connections_active",
+                max(100, world.demand),
+                "connections",
+                "support",
+            )
+            observe(
+                "database",
+                "postgres",
+                at,
+                "Connection admission rejected at server cap",
+                dict(
+                    category="connections",
+                    connection_count=world.demand,
+                    connection_limit=world.capacity,
+                ),
+                "support",
+            )
+            observe(
+                "configs",
+                "backend",
+                at,
+                "db_pool_max remains 20; concurrency=120",
+                {"change_id": "baseline-1"},
+                "contradicting",
+            )
+        elif mode in {"postgres_lock_contention", "postgres_slow_query"}:
+            locked = mode == "postgres_lock_contention"
+            observe(
+                "database",
+                "postgres",
+                at,
+                "Session waiting on transaction lock" if locked else "Query execution sampled",
+                dict(
+                    category="lock_waits" if locked else "slow_queries",
+                    session_id="session-9",
+                    blocked_by="session-2" if locked else "",
+                    wait_event="transaction_lock" if locked else "CPU",
+                    duration_ms=world.delay_ms,
+                    query_fingerprint="select-shape-7",
+                ),
+                "support",
+            )
+            metric("postgres", at, "query_latency_ms", world.delay_ms, "ms", "support")
+            observe(
+                "database",
+                "postgres",
+                at,
+                "Connections healthy below server cap",
+                dict(category="connections", connection_count=30, connection_limit=100),
+                "contradicting",
+            )
+        elif mode == "redis_unavailable":
+            metric("redis", at, "availability", 0, "ratio", "support")
+            observe("logs", "redis", at, "Listener connection refused", role="support")
+            metric("payment", at, "p95_latency_ms", 60, "ms", "contradicting")
+        elif mode == "payment_external_timeout":
+            metric("payment", at, "p95_latency_ms", world.delay_ms, "ms", "support")
+            observe("logs", "payment", at, "External request exceeded deadline", role="support")
+            metric("redis", at, "availability", 1, "ratio", "contradicting")
+        elif mode == "backend_resource_saturation":
+            metric("backend", at, "cpu_percent", 98, "percent", "support")
+            observe(
+                "logs", "backend", at, "CPU worker threads saturated at 98 percent", role="support"
+            )
+            metric("postgres", at, "connections_active", 30, "connections", "contradicting")
+        else:
+            # Unknown observations remain a diagnostic challenge, not a supported root.
+            metric(world.root_service, at, "clock_offset_ms", world.delay_ms, "ms")
+    if mode != "healthy":
+        observe("logs", "backend", world.symptom_at, "Request processing exceeded deadline")
+        metric("gateway", world.symptom_at, "http_5xx_rate", 0.35, "ratio")
+    else:
+        metric("gateway", world.symptom_at, "http_5xx_rate", 0, "ratio")
+        observe("logs", "backend", world.symptom_at, "Request completed normally")
+    if world.misleading:
+        # Late, noncausal deployment follows the symptom rather than causing it.
+        observe(
+            "changes",
+            "gateway",
+            world.symptom_at + timedelta(seconds=30),
+            "Presentation asset deployment completed; routing unchanged",
+            {"change_id": "assets-2", "change_type": "deployment"},
+            "misleading",
+        )
+    return rows, roles
diff --git a/src/incident_lens/incidentbench/schemas.py b/src/incident_lens/incidentbench/schemas.py
new file mode 100644
index 0000000..120dba5
--- /dev/null
+++ b/src/incident_lens/incidentbench/schemas.py
@@ -0,0 +1,117 @@
+"""Frozen V1 benchmark contracts. Candidate labels are never human acceptance."""
+
+from typing import Literal
+
+from pydantic import Field, model_validator
+
+from incident_lens.schemas.contracts import Identifier, StrictModel, Text
+
+INTERFACE_VERSION = "incidentbench-v1.0"
+VARIANTS = (
+    "strong_single_equivalent_tools",
+    "fixed_four_equivalent_tools",
+    "dynamic_no_verifier",
+    "full",
+)
+SUPPORTED_MODES = frozenset(
+    {
+        "backend_pool_config_regression",
+        "postgres_connection_exhaustion",
+        "redis_unavailable",
+        "payment_external_timeout",
+        "backend_resource_saturation",
+        "postgres_lock_contention",
+        "postgres_slow_query",
+    }
+)
+
+
+class BenchmarkRootCause(StrictModel):
+    culprit_service: Identifier
+    failure_mode: Text
+    root_cause_code: Text
+
+
+class EvidenceSupportSet(StrictModel):
+    evidence_ids: list[Identifier] = Field(min_length=1)
+    rationale: Text
+
+
+class BenchmarkOracle(StrictModel):
+    incident_id: Identifier
+    scenario_family_id: Identifier
+    mechanism_id: Text
+    counterfactual_pair_id: Identifier | None = None
+    is_identifiable: bool
+    true_primary_root: BenchmarkRootCause
+    acceptable_support_sets: list[EvidenceSupportSet]
+    contradicting_evidence_ids: list[Identifier]
+    misleading_evidence_ids: list[Identifier]
+    required_discriminator_types: list[Text]
+    causal_sequence: list[Text]
+    identifiability_rationale: Text
+    annotator_status: Literal["pending", "adjudicated", "accepted"] = "pending"
+    review_version: Text = "candidate-v1"
+    cohort: Literal["core", "ood", "monitoring"] = "core"
+    reviewer_ids: list[Identifier] = Field(default_factory=list)
+
+    @model_validator(mode="after")
+    def truthful_labels(self):
+        if self.cohort == "core" and self.true_primary_root.failure_mode not in SUPPORTED_MODES:
+            raise ValueError("unsupported core mechanism")
+        if self.is_identifiable != bool(self.acceptable_support_sets):
+            raise ValueError("identifiability requires sufficient sets; missing cases have none")
+        if self.annotator_status != "pending" and len(set(self.reviewer_ids)) < 2:
+            raise ValueError("accepted labels require two independent reviewer identities")
+        return self
+
+
+class BenchmarkCaseMetadata(StrictModel):
+    incident_id: Identifier
+    split: Literal["seed", "dev", "test"]
+    scenario_family_id: Identifier
+    scenario_variant_id: Identifier
+    challenge_tags: list[Text]
+    public_sha256: Text
+    source_blueprint_id: Identifier
+    near_duplicate_cluster_id: Identifier
+    counterfactual_pair_id: Identifier | None = None
+    cohort: Literal["core", "ood", "monitoring"] = "core"
+
+
+class ExperimentProtocol(StrictModel):
+    protocol_id: Text = "incidentbench-v1-development"
+    benchmark_version: Literal["incidentbench-v1"] = "incidentbench-v1"
+    provider_id: Literal["mock", "real"] = "mock"
+    model_id: Text = "mock"
+    temperature: float = 0.0
+    cache_mode: Literal["off"] = "off"
+    jobs: Literal[1] = 1
+    run_order_seed: int = 14100
+    repeats: int = Field(default=1, ge=1)
+    variants: list[Text] = Field(default_factory=lambda: list(VARIANTS))
+    max_rounds: int = Field(default=6, ge=1)
+    max_tool_calls: int = Field(default=24, ge=1)
+    max_llm_calls: int = Field(default=32, ge=1)
+    max_wall_seconds: float = Field(default=600.0, gt=0)
+    response_format: Literal["json_schema", "json_object"] = "json_schema"
+    request_timeout: float = 180.0
+    blindness_level: Literal["development_visible", "independent_label_owner"] = (
+        "development_visible"
+    )
+    formal: bool = False
+    analysis_seed: int = 14101
+    bootstrap_samples: int = Field(default=10000, ge=1)
+    analysis_plan: Literal["family_clustered_paired_bootstrap_plus_exact_discordance"] = (
+        "family_clustered_paired_bootstrap_plus_exact_discordance"
+    )
+
+    @model_validator(mode="after")
+    def conditions(self):
+        if len(set(self.variants)) != len(self.variants) or set(self.variants) != set(VARIANTS):
+            raise ValueError("protocol requires the four equivalent-tool variants")
+        if self.formal and (
+            self.provider_id != "real" or self.model_id in {"mock", "TO_FILL_BEFORE_FREEZE"}
+        ):
+            raise ValueError("formal protocol requires a frozen real model")
+        return self
diff --git a/src/incident_lens/incidentbench/scorer.py b/src/incident_lens/incidentbench/scorer.py
new file mode 100644
index 0000000..210b2e7
--- /dev/null
+++ b/src/incident_lens/incidentbench/scorer.py
@@ -0,0 +1,179 @@
+"""Failure-inclusive causal scoring, separate from human semantic review."""
+
+import hashlib
+import json
+from collections import Counter
+from statistics import mean
+
+from .normalizer import normalize
+from .schemas import BenchmarkOracle
+
+
+def score_benchmark_run(state, oracle=None, annotations=None):
+    result = normalize(state)
+    result.update(
+        scoring_version="incidentbench-v1.0",
+        label_status="unscored",
+        identifiable=None,
+        root_cause_correct=None,
+        correct_abstention=None,
+        misleading_correct=None,
+        misleading_case=None,
+        human_support_rate=None,
+        unsupported_claim_rate=None,
+        human_grounded_success=None,
+        human_review_coverage=None,
+        semantic_review_status="unreviewed",
+    )
+    if oracle is not None:
+        oracle = (
+            oracle
+            if isinstance(oracle, BenchmarkOracle)
+            else BenchmarkOracle.model_validate(oracle)
+        )
+        if oracle.incident_id != state["incident_id"]:
+            raise ValueError("oracle incident mismatch")
+        root = (state.get("report") or {}).get("root_cause") or {}
+        correct = bool(
+            result["technical_completion"]
+            and result["resolved"]
+            and root.get("culprit_service") == oracle.true_primary_root.culprit_service
+            and root.get("failure_mode") == oracle.true_primary_root.failure_mode
+        )
+        result.update(
+            label_status="provisional"
+            if oracle.annotator_status == "pending"
+            else oracle.annotator_status,
+            oracle_sha256=hashlib.sha256(
+                json.dumps(
+                    oracle.model_dump(mode="json"), sort_keys=True, separators=(",", ":")
+                ).encode()
+            ).hexdigest(),
+            oracle_review_version=oracle.review_version,
+            identifiable=oracle.is_identifiable,
+            root_cause_correct=correct if oracle.is_identifiable else None,
+            correct_abstention=result["abstained"] if not oracle.is_identifiable else None,
+            misleading_case=bool(oracle.misleading_evidence_ids),
+            misleading_correct=correct
+            if oracle.is_identifiable and oracle.misleading_evidence_ids
+            else None,
+        )
+    if annotations is not None:
+        from .citation_review import merge_reviews, prepare_review_bundle, review_coverage
+
+        bundle = annotations["bundle"]
+        if bundle != prepare_review_bundle([state]):
+            raise ValueError(
+                "review bundle must exactly cover this run's key claims and observed evidence"
+            )
+        merged = merge_reviews(bundle, annotations["records"], annotations.get("adjudications"))
+        coverage = review_coverage(bundle, merged)
+        factual = [
+            r
+            for r in merged
+            if r["annotation_status"] in {"final", "adjudicated"}
+            and r["review_label"] != "NOT_APPLICABLE"
+        ]
+        result.update(
+            human_factual_claim_n=len(factual),
+            human_supported_claim_n=sum(r["review_label"] == "SUPPORTED" for r in factual),
+            human_unsupported_claim_n=sum(
+                r["review_label"] in {"CONTRADICTED", "INSUFFICIENT"} for r in factual
+            ),
+        )
+        result.update(
+            human_support_rate=coverage["human_support_rate"],
+            unsupported_claim_rate=coverage["unsupported_claim_rate"],
+            human_review_coverage=coverage["coverage"],
+            semantic_review_status="reviewed" if coverage["reviewed_claims"] else "unreviewed",
+        )
+        if coverage["coverage"] == 1 and result["identifiable"]:
+            result["human_grounded_success"] = bool(
+                result["root_cause_correct"]
+                and all(r["review_label"] == "SUPPORTED" for r in merged)
+            )
+    return result
+
+
+def aggregate(rows):
+    """Core denominators include technical failures; nulls never become zero."""
+    output = []
+    for variant in sorted({r["variant"] for r in rows}):
+        group = [r for r in rows if r["variant"] == variant and r.get("cohort", "core") == "core"]
+
+        def rate(key):
+            values = [r[key] for r in group if r.get(key) is not None]
+            return {
+                "numerator": sum(values),
+                "denominator": len(values),
+                "rate": mean(values) if values else None,
+            }
+
+        item = {
+            "variant": variant,
+            "tested_n": len(group),
+            "label_status_counts": dict(Counter(r.get("label_status", "unscored") for r in group)),
+            "failure_counts": dict(
+                Counter(
+                    r.get("failure_category") or r.get("termination_reason") or "UNKNOWN"
+                    for r in group
+                    if not r.get("technical_completion")
+                )
+            ),
+        }
+        for key, name in (
+            ("technical_completion", "investigation_completion_rate"),
+            ("root_cause_correct", "root_cause_accuracy"),
+            ("correct_abstention", "correct_abstention_rate"),
+            ("misleading_correct", "misleading_accuracy"),
+        ):
+            item[name] = rate(key)
+        cited = sum(r.get("citation_count", 0) for r in group)
+        item["citation_existence_validity"] = (
+            sum(r.get("valid_citation_count", 0) for r in group) / cited if cited else None
+        )
+        attempts = [r.get("actual_http_requests") for r in group]
+        item["total_http_attempts"] = (
+            sum(attempts) if all(v is not None for v in attempts) else None
+        )
+        item["request_count_completeness"] = (
+            sum(v is not None for v in attempts) / len(group) if group else None
+        )
+        item["known_http_attempts_lower_bound"] = sum(v for v in attempts if v is not None)
+        item["token_completeness"] = (
+            sum(r.get("total_tokens") is not None for r in group) / len(group) if group else None
+        )
+        item["total_tokens"] = (
+            sum(r["total_tokens"] for r in group)
+            if group and all(r.get("total_tokens") is not None for r in group)
+            else None
+        )
+        item["latency_ms"] = (
+            mean(r["latency_ms"] for r in group)
+            if group and all(r.get("latency_ms") is not None for r in group)
+            else None
+        )
+        item.update(
+            human_support_rate=None, unsupported_claim_rate=None, human_grounded_success_rate=None
+        )
+        for metric in ("human_support_rate", "unsupported_claim_rate", "human_grounded_success"):
+            reviewed = [r[metric] for r in group if r.get(metric) is not None]
+            item[
+                metric if metric != "human_grounded_success" else "human_grounded_success_rate"
+            ] = mean(reviewed) if reviewed else None
+        item["human_audited_run_n"] = sum(
+            r.get("human_grounded_success") is not None for r in group
+        )
+        factual_n = sum(r.get("human_factual_claim_n", 0) for r in group)
+        item["human_support_rate"] = (
+            sum(r.get("human_supported_claim_n", 0) for r in group) / factual_n
+            if factual_n
+            else None
+        )
+        item["unsupported_claim_rate"] = (
+            sum(r.get("human_unsupported_claim_n", 0) for r in group) / factual_n
+            if factual_n
+            else None
+        )
+        output.append(item)
+    return output
diff --git a/src/incident_lens/incidentbench/statistics.py b/src/incident_lens/incidentbench/statistics.py
new file mode 100644
index 0000000..ea25dc1
--- /dev/null
+++ b/src/incident_lens/incidentbench/statistics.py
@@ -0,0 +1,130 @@
+"""Repeat-averaged case contrasts with paired family-cluster bootstrap."""
+
+import math
+import random
+from collections import defaultdict
+from statistics import mean
+
+
+def effective_clusters(rows):
+    """Union declared families linked by a common blueprint or duplicate source."""
+    parents = {}
+
+    def find(key):
+        parents.setdefault(key, key)
+        if parents[key] != key:
+            parents[key] = find(parents[key])
+        return parents[key]
+
+    cases = {}
+    for row in rows:
+        keys = [
+            (field, row[field])
+            for field in (
+                "scenario_family_id",
+                "source_blueprint_id",
+                "near_duplicate_cluster_id",
+                "counterfactual_pair_id",
+            )
+            if row.get(field)
+        ]
+        if not keys:
+            raise ValueError("statistical source group missing")
+        for key in keys[1:]:
+            left, right = find(keys[0]), find(key)
+            parents[max(left, right)] = min(left, right)
+        cases[row["incident_id"]] = keys[0]
+    return {case: ":".join(find(key)) for case, key in cases.items()}
+
+
+def paired_comparison(rows, baseline, metric="root_cause_correct", *, seed=14101, samples=10000):
+    if samples < 1:
+        raise ValueError("bootstrap samples must be positive")
+    cells = defaultdict(dict)
+    grouping = effective_clusters(rows)
+    for row in rows:
+        if row.get("cohort", "core") != "core" or row["variant"] not in {"full", baseline}:
+            continue
+        if row.get(metric) is None:
+            continue
+        key = (grouping[row["incident_id"]], row["incident_id"])
+        cell = cells[key].setdefault(row["variant"], {})
+        repeat = row.get("repeat_id", 0)
+        if repeat in cell:
+            raise ValueError("duplicate case/variant/repeat")
+        cell[repeat] = float(row[metric])
+    if not cells:
+        return {"baseline": baseline, "metric": metric, "status": "no_scored_pairs", "paired_n": 0}
+    families = defaultdict(list)
+    discordant_plus = discordant_minus = 0
+    repeats = []
+    for (family, case), pair in cells.items():
+        if set(pair) != {"full", baseline} or set(pair["full"]) != set(pair[baseline]):
+            raise ValueError(f"missing paired variant/repeat for {case}")
+        full, control = mean(pair["full"].values()), mean(pair[baseline].values())
+        families[family].append(full - control)
+        repeats.append(len(pair["full"]))
+        if len(pair["full"]) == 1 and full in (0, 1) and control in (0, 1):
+            discordant_plus += full > control
+            discordant_minus += full < control
+    clusters = list(families.values())
+    rng = random.Random(seed)
+    draws = []
+    for _ in range(samples):
+        chosen = [rng.choice(clusters) for _ in clusters]
+        draws.append(mean(value for cluster in chosen for value in cluster))
+    draws.sort()
+    discordance_n = discordant_plus + discordant_minus
+    exact = (
+        min(
+            1.0,
+            2
+            * sum(
+                math.comb(discordance_n, k)
+                for k in range(min(discordant_plus, discordant_minus) + 1)
+            )
+            / 2**discordance_n,
+        )
+        if discordance_n
+        else 1.0
+    )
+    return {
+        "baseline": baseline,
+        "metric": metric,
+        "status": "insufficient_clusters"
+        if len(clusters) < 2
+        else "exploratory"
+        if len(clusters) < 20
+        else "estimated",
+        "paired_n": len(cells),
+        "family_n": len(clusters),
+        "effective_source_clusters": len(clusters),
+        "declared_family_n": len({r["scenario_family_id"] for r in rows}),
+        "independence_status": "unreviewed"
+        if any(r.get("independence_status") == "unreviewed" for r in rows)
+        else "not_established",
+        "repeat_counts": repeats,
+        "difference": mean(v for c in clusters for v in c),
+        "ci95": [draws[int((samples - 1) * 0.025)], draws[int((samples - 1) * 0.975)]]
+        if len(clusters) >= 2
+        else None,
+        "family_differences": {k: mean(v) for k, v in families.items()},
+        "exact_discordance_p": exact
+        if len(clusters) >= 2 and all(n == 1 for n in repeats)
+        else None,
+        "exact_discordance_note": "supplementary; assumes independent cases, unlike primary family bootstrap",
+        "small_family_warning": len(clusters) < 20,
+        "seed": seed,
+        "bootstrap_samples": samples,
+    }
+
+
+def analyze(rows, *, seed=14101, samples=10000):
+    return [
+        paired_comparison(rows, variant, seed=seed, samples=samples)
+        for variant in (
+            "strong_single_equivalent_tools",
+            "fixed_four_equivalent_tools",
+            "dynamic_no_verifier",
+        )
+    ]
diff --git a/src/incident_lens/incidentbench/validator.py b/src/incident_lens/incidentbench/validator.py
new file mode 100644
index 0000000..976ba6f
--- /dev/null
+++ b/src/incident_lens/incidentbench/validator.py
@@ -0,0 +1,189 @@
+"""Public compatibility and evaluator-only causal/leakage audits."""
+
+import json
+import re
+from collections import Counter
+from difflib import SequenceMatcher
+
+from incident_lens.orchestration.guards import cause_discriminator
+from incident_lens.schemas import Hypothesis
+from incident_lens.tools.provider import PUBLIC_FILES, SOURCE_FILES, EvidenceProvider
+
+from .manifest import digest_tree
+from .oracle_store import safe_path
+from .schemas import BenchmarkCaseMetadata, BenchmarkOracle
+
+
+def validate_dataset(dataset, oracle_root=None):
+    errors = []
+    coverage = Counter()
+    try:
+        dataset = safe_path(dataset)
+        rca = dataset / "rca" if (dataset / "rca").exists() else dataset
+        safe_path(rca)
+        provider = EvidenceProvider(rca)
+        errors.extend(provider.validate_public())
+        index_path = dataset / "public_case_index.json"
+        raw = json.loads(safe_path(index_path).read_bytes())
+        rows = raw if isinstance(raw, list) else raw["cases"]
+        metadata = [BenchmarkCaseMetadata.model_validate(row) for row in rows]
+        for split in ("seed", "dev", "test"):
+            for cohort in ("core", "monitoring", "ood"):
+                coverage[f"{split}/{cohort}"] = 0
+        pairs = Counter(
+            row.counterfactual_pair_id for row in metadata if row.counterfactual_pair_id
+        )
+        if any(count != 2 for count in pairs.values()):
+            errors.append("counterfactual group requires exactly two cases")
+        ids = [row.incident_id for row in metadata]
+        if len(ids) != len(set(ids)) or set(ids) != {
+            case.incident_id for case in provider.list_cases()
+        }:
+            errors.append("case index coverage mismatch")
+        for split in ("seed", "dev", "test"):
+            actual = json.loads(safe_path(rca / "splits" / f"{split}_ids.json").read_bytes())
+            expected = [row.incident_id for row in metadata if row.split == split]
+            if len(actual) != len(set(actual)) or set(actual) != set(expected):
+                errors.append("split index mismatch")
+        manifest = json.loads(safe_path(dataset / "manifest.json").read_bytes())
+        if manifest.get("rca_public_sha256") != digest_tree(rca):
+            errors.append("manifest public bundle hash mismatch")
+        if manifest.get("benchmark_version") != "incidentbench-v1":
+            errors.append("manifest version mismatch")
+        groups = {}
+        texts = {}
+        oracles = {}
+        observations = {}
+        for row in metadata:
+            coverage[f"{row.split}/{row.cohort}"] += 1
+            public = rca / "incidents" / row.incident_id / "public"
+            for path in public.rglob("*"):
+                safe_path(path)
+                if path.is_dir() or path.name not in PUBLIC_FILES:
+                    errors.append("unexpected public file")
+            if digest_tree(public) != row.public_sha256:
+                errors.append("public hash mismatch")
+            for field in (
+                "scenario_family_id",
+                "source_blueprint_id",
+                "near_duplicate_cluster_id",
+                "counterfactual_pair_id",
+            ):
+                value = getattr(row, field)
+                if value:
+                    key = (field, value)
+                    if key in groups and groups[key] != row.split:
+                        errors.append(f"cross-split {field}")
+                    groups[key] = row.split
+            records = [
+                record
+                for source in (*SOURCE_FILES, "topology")
+                for record in provider._records(row.incident_id, source)
+            ]
+            observations[row.incident_id] = sorted(
+                (
+                    record.source_type,
+                    record.service,
+                    re.sub(r"incident_\d+", "#", record.excerpt),
+                    json.dumps(record.metadata, sort_keys=True),
+                )
+                for record in records
+                if record.source_type != "topology"
+            )
+            normalized = " ".join(
+                record.excerpt for record in records if record.source_type != "topology"
+            )
+            normalized = re.sub(r"incident_\d+|\d+|[0-9a-f]{16,}", "#", normalized.lower())
+            texts[row.incident_id] = (row.split, normalized)
+            if oracle_root is not None:
+                root = safe_path(oracle_root)
+                if root.is_relative_to(dataset) or dataset.is_relative_to(root):
+                    raise PermissionError("oracle and public roots must be disjoint")
+                oracle = BenchmarkOracle.model_validate_json(
+                    safe_path(
+                        root
+                        / "rca"
+                        / "incidents"
+                        / row.incident_id
+                        / "private"
+                        / "benchmark_oracle.json"
+                    ).read_bytes()
+                )
+                oracles[row.incident_id] = oracle
+                if (
+                    oracle.incident_id != row.incident_id
+                    or oracle.scenario_family_id != row.scenario_family_id
+                    or oracle.cohort != row.cohort
+                    or oracle.counterfactual_pair_id != row.counterfactual_pair_id
+                ):
+                    errors.append("oracle metadata mismatch")
+                lookup = {r.evidence_id: r for r in records}
+                hypothesis = Hypothesis(
+                    hypothesis_id="oracle_audit",
+                    culprit_service=oracle.true_primary_root.culprit_service,
+                    failure_mode=oracle.true_primary_root.failure_mode,
+                )
+                discriminator_records = [r for r in records if cause_discriminator(hypothesis, r)]
+                if (
+                    not oracle.is_identifiable
+                    and discriminator_records
+                    and len(
+                        {r.source_type for r in records if r.service == hypothesis.culprit_service}
+                    )
+                    >= 2
+                ):
+                    errors.append(
+                        "insufficient case exposes discriminator and support; human review required"
+                    )
+                referenced = set(oracle.contradicting_evidence_ids + oracle.misleading_evidence_ids)
+                for support in oracle.acceptable_support_sets:
+                    referenced.update(support.evidence_ids)
+                    selected = [lookup[e] for e in support.evidence_ids if e in lookup]
+                    if len({r.source_type for r in selected}) < 2:
+                        errors.append("support lacks independent sources")
+                    if not set(oracle.required_discriminator_types).issubset(
+                        {r.source_type for r in selected}
+                    ):
+                        errors.append("support lacks required discriminator")
+                    causes = [r for r in selected if cause_discriminator(hypothesis, r)]
+                    if not causes:
+                        errors.append("support lacks cause-specific discriminator")
+                    symptoms = [r for r in selected if r.source_type == "logs"]
+                    if (
+                        causes
+                        and symptoms
+                        and min(r.observed_at for r in causes)
+                        > max(r.observed_at for r in symptoms)
+                    ):
+                        errors.append("cause observation follows all support symptoms")
+                    case = provider.load_case(row.incident_id)
+                    if any(r.observed_at < case.started_at for r in selected):
+                        errors.append("support precedes incident window")
+                if not referenced.issubset(lookup):
+                    errors.append("oracle references absent evidence")
+                if not oracle.causal_sequence or not oracle.identifiability_rationale:
+                    errors.append("missing causal rationale")
+        for i, left in enumerate(metadata):
+            for right in metadata[i + 1 :]:
+                if (
+                    left.split != right.split
+                    and SequenceMatcher(
+                        None, texts[left.incident_id][1], texts[right.incident_id][1]
+                    ).ratio()
+                    >= 0.97
+                ):
+                    errors.append("cross-split near-duplicate requires review")
+                if (
+                    oracle_root
+                    and left.counterfactual_pair_id
+                    and left.counterfactual_pair_id == right.counterfactual_pair_id
+                ):
+                    a, b = oracles[left.incident_id], oracles[right.incident_id]
+                    if (
+                        a.true_primary_root == b.true_primary_root
+                        or observations[left.incident_id] == observations[right.incident_id]
+                    ):
+                        errors.append("invalid counterfactual pair")
+    except (OSError, ValueError, KeyError, TypeError, PermissionError):
+        errors.append("invalid benchmark resource or contract")
+    return {"ok": not errors, "errors": sorted(set(errors)), "coverage": dict(coverage)}
